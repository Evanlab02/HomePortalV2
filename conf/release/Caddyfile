(inttls) {
	tls /certs/fullchain.cer /certs/labuschagne.xyz.key
}

app.labuschagne.xyz,
api.labuschagne.xyz {
	import inttls

	handle_path /* {
		reverse_proxy app:80
	}

	handle_path /static/* {
		root * /var/www/html/homeportal/static/
		file_server
	}
}

admin.labuschagne.xyz {
	import inttls

	handle_path /* {
		reverse_proxy admin:80
	}

	handle_path /static/* {
		root * /var/www/html/homeportal/static/
		file_server
	}
}

docs.labuschagne.xyz {
	import inttls

	handle_path /HomePortalV2/* {
		root * /var/www/html/docs/
		file_server
	}
}
